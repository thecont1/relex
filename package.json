{
  "name": "relexplorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cense": "TENANT=cense vite",
    "dev:test-dept": "TENANT=test-dept vite",
    "build": "tsc -b && vite build",
    "build:cense": "TENANT=cense tsc -b && TENANT=cense vite build",
    "build:test-dept": "TENANT=test-dept tsc -b && TENANT=test-dept vite build",
    "build:all": "bun run build:cense && bun run build:test-dept",
    "preview": "vite preview --port 4173",
    "preview:cense": "TENANT=cense vite preview --port 4173",
    "preview:test-dept": "TENANT=test-dept vite preview --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "cytoscape": "^3.30.2",
    "cytoscape-fcose": "^2.2.0",
    "cytoscape-svg": "^0.4.0",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.7",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
